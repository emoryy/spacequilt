class Node:
    __slots__ = ("path", "size", "children", "parent", "kind", "_kids")

    # Leaves share one immutable empty tuple instead of each owning a list:
    # files are the bulk of a scan and the list per node was a third of the
    # tree's memory and a good part of its build time.
    def __init__(self, path, size, kind=None):
        self.path = path
        self.size = size          # bytes, as reported by du (cumulative)
        self.children = ()
        self.parent = None
        # None for a real entry; "group" = synthetic "N smaller items"
        # aggregate, "disk" = wrapper over a mount point, "free" = its free
        # space. Synthetic nodes keep their label in .path.
        self.kind = kind
        self._kids = None

    @property
    def is_group(self):
        return self.kind == "group"

    @property
    def synthetic(self):
        return self.kind is not None

    @property
    def children_size(self):
        """Total size of the direct children, computed once.

        The layout needs the size of the undrawn tail every frame; summing it
        directly is O(children) per directory per frame, which for a cache
        directory with tens of thousands of files is what makes panning lag.
        """
        if self._kids is None:
            self._kids = sum(c.size for c in self.children)
        return self._kids

    @property
    def name(self):
        if self.kind is not None:
            return self.path
        base = os.path.basename(self.path.rstrip("/"))
        return base or self.path   # root ("/") keeps its full path


# Dot stipple over "N smaller items" areas, as SpaceMonger 2 drew the parts
# too small to resolve. Alpha is what keeps it a texture rather than a tone.
STIPPLE = None   # QBrush, created once a QGuiApplication exists (see _stipple)


def _stipple():
    global STIPPLE
    if STIPPLE is None:
        # 2px dots on a 6px diagonal grid: coarse enough to read as dots, not
        # as a darker tone (the 1px checkerboard patterns blur into one).
        tile = QPixmap(6, 6)
        tile.fill(Qt.transparent)
        p = QPainter(tile)
        p.fillRect(0, 0, 2, 2, QColor(0, 0, 0, 105))
        p.fillRect(3, 3, 2, 2, QColor(0, 0, 0, 105))
        p.end()
        STIPPLE = QBrush(tile)
    return STIPPLE


def human(size):
    """Human-readable size, base 1024."""
    units = ("B", "KiB", "MiB", "GiB", "TiB", "PiB")
    s = float(size)
    for u in units:
        if s < 1024 or u == units[-1]:
            return f"{s:.0f} {u}" if u == "B" else f"{s:.1f} {u}"
        s /= 1024


class TreeBuilder:
    """Accumulates `du -k --all` lines into a Node tree.

    Feed lines as they arrive so parsing overlaps with du still walking the
    disk, then call finish(). The cyclic GC is paused while building: with
    millions of small objects being allocated it otherwise re-scans the
    growing heap over and over and dominates the run time.
    """

    def __init__(self):
        self.nodes = {}
        self.last_path = None
        self.entries = None          # set once finished; the dict is dropped
        self._gc_was_enabled = gc.isenabled()
        gc.disable()

    def count(self):
        return self.entries if self.entries is not None else len(self.nodes)

    def add(self, line):
        size, tab, path = line.partition("\t")
        if not tab:
            return
        try:
            size_kib = int(size)
        except ValueError:
            return
        if path.endswith("\n"):
            path = path[:-1]
        self.nodes[path] = Node(path, size_kib * 1024)
        self.last_path = path

    def finish(self):
        """Link parents, sort children; return the root Node or None."""
        try:
            return self._finish()
        finally:
            if self._gc_was_enabled:
                gc.enable()

    def discard(self):
        """Drop a partial tree (cancelled scan) and resume the GC."""
        self.nodes = {}
        if self._gc_was_enabled:
            gc.enable()

    def _finish(self):
        nodes = self.nodes
        if not nodes:
            return None
        get = nodes.get
        for path, node in nodes.items():
            parent_path = path.rpartition("/")[0]
            if not parent_path and path.startswith("/"):
                parent_path = "/"
            parent = get(parent_path)
            if parent is not None and parent is not node:
                kids = parent.children
                if not kids:
                    parent.children = kids = []
                kids.append(node)
                node.parent = parent

        # Root = the deepest-listed node with no in-set parent (du prints it last).
        root = nodes.get(self.last_path)
        while root is not None and root.parent is not None:
            root = root.parent
        if root is None:
            root = max(nodes.values(), key=operator.attrgetter("size"))

        by_size = operator.attrgetter("size")
        for node in nodes.values():
            kids = node.children
            if kids:
                kids.sort(key=by_size, reverse=True)
                # Summed here, off the GUI thread: the boxes view touches
                # every visible directory's total on its first frame.
                node._kids = sum(c.size for c in kids)
        # The tree holds every node from here on; keeping the path index too
        # would double the memory for nothing.
        self.entries = len(nodes)
        self.nodes = {}
        return root


def build_tree(du_output):
    """Turn `du -k --all` output into a Node tree; return the root Node."""
    builder = TreeBuilder()
    for line in du_output.splitlines():
        builder.add(line)
    return builder.finish()


_OCTAL_ESCAPE = re.compile(rb"\\([0-7]{3})")


def _unescape_mount(field):
    """/proc/mounts escapes space, tab, newline and backslash as \\ooo; undo
    that on the raw bytes, then decode like the kernel handed us the name."""
    raw = _OCTAL_ESCAPE.sub(lambda m: bytes([int(m.group(1), 8)]), field)
    return raw.decode("utf-8", "surrogateescape")


def _mount_device(mount_point):
    """Device (or fs source) mounted at `mount_point`, from /proc/mounts."""
    device = None
    try:
        with open("/proc/mounts", "rb") as f:
            for line in f:
                parts = line.split()
                if len(parts) < 2:
                    continue
                if _unescape_mount(parts[1]) == mount_point:
                    device = _unescape_mount(parts[0])   # later lines win
    except (OSError, ValueError):
        pass
    return device or mount_point


class DiskNode(Node):
    """The wrapper over a mount point; carries the volume's statvfs numbers so
    the GUI never has to touch the filesystem for them."""
    __slots__ = ("total", "free")

    def __init__(self, label, size, total, free):
        super().__init__(label, size, kind="disk")
        self.total = total
        self.free = free


def wrap_mount(root, path):
    """Put a "disk" node over `root` with a sibling "free" block, like
    SpaceMonger's free-space tile, so the tree shows what the volume has left."""
    try:
        st = os.statvfs(path)
    except OSError:
        return root
    free = st.f_bavail * st.f_frsize
    total = st.f_blocks * st.f_frsize
    disk = DiskNode(_mount_device(path), root.size + free, total, free)
    disk.children = [root, Node("Free space", free, kind="free")]
    disk.children.sort(key=operator.attrgetter("size"), reverse=True)
    for child in disk.children:
        child.parent = disk
    return disk


def volume_status(node):
    """Status-bar text for a "disk" node: usage of the volume it wraps."""
    real = next((c for c in node.children if c.kind is None), None)
    if real is None or not isinstance(node, DiskNode):
        return f"{node.name}    {human(node.size)}"
    total, free = node.total, node.free
    pct = 100.0 * free / total if total else 0.0
    return (
        f"{node.name} on {real.path}    {human(total)} total, "
        f"{human(total - free)} used, {human(free)} free ({pct:.1f}%)"
    )


class Scanner(QThread):
    done = Signal(object)          # emits root Node
    failed = Signal(str)

    def __init__(self, path, one_fs, expected_entries=None):
        super().__init__()
        self.path = path
        self.one_fs = one_fs
        self._proc = None
        self._aborted = False
        self.started_at = time.monotonic()
        # Progress is read by the GUI thread straight off the builder, so
        # the scan loop itself pays nothing for it. The target is the used
        # inode count of the volume for a mount-point scan (every du line is
        # one inode, give or take hardlinks), else the previous scan's entry
        # count for this path; None means indeterminate.
        self.builder = None
        self.target = expected_entries or None
        self.is_mount = False        # decided in run(): it touches the fs

    def progress(self):
        """(entries so far, target or None, directory being walked, seconds)."""
        b = self.builder
        entries = b.count() if b is not None else 0
        last = b.last_path if b is not None else None
        current = last.rpartition("/")[0] or last if last else self.path
        return entries, self.target, current, time.monotonic() - self.started_at

    def run(self):
        self.is_mount = self.one_fs and os.path.ismount(self.path)
        if self.is_mount:
            try:
                st = os.statvfs(self.path)
                if st.f_files > 0:
                    self.target = st.f_files - st.f_ffree
            except OSError:
                pass
        cmd = ["du", "-k", "--all"]
        if self.one_fs:
            cmd.append("-x")
        cmd.append(self.path)
        # stderr goes to a file: du can emit thousands of permission errors,
        # and a pipe we are not draining while reading stdout would block it.
        with tempfile.TemporaryFile(mode="w+", encoding="utf-8",
                                    errors="replace") as err_file:
            try:
                # Popen rather than run(), so abort() can reach the child: a du
                # over / outlives the window otherwise.
                self._proc = subprocess.Popen(
                    cmd, stdout=subprocess.PIPE, stderr=err_file,
                    text=True, errors="replace",
                )
            except OSError as exc:
                self.failed.emit(str(exc))
                return
            if self._aborted:
                # abort() came before the child existed and had nothing to
                # kill; do it for it instead of walking the whole disk.
                self.abort()
                self._proc.wait()
                return
            # Parse as the lines arrive, so building the tree overlaps with du
            # walking the disk instead of starting after it.
            builder = self.builder = TreeBuilder()
            add = builder.add
            with self._proc.stdout:
                for line in self._proc.stdout:
                    add(line)
            self._proc.wait()
            if self._aborted:
                builder.discard()
                return
            root = builder.finish()
            if root is None:
                err_file.seek(0)
                msg = err_file.read().strip() or "du returned no usable output."
                self.failed.emit(msg)
                return
        # One deliberate full collection here, off the GUI thread's schedule:
        # the millions of nodes just allocated would otherwise trigger it at
        # some random later moment as a visible pause.
        gc.collect()
        if self.is_mount:
            root = wrap_mount(root, self.path)
        if self._aborted:            # cancelled during the seconds above
            return
        self.done.emit(root)

    def abort(self):
        """Stop caring about this scan and kill the du behind it."""
        self._aborted = True
        proc = self._proc
        if proc is not None and proc.poll() is None:
            try:
                proc.terminate()
            except OSError:
                pass


class TreeView(QWidget):
    """What the two views share: the tree, focus/selection/hover, colour
    schemes, labels, the scanning overlay, crossfades, mouse and keyboard
    handling. A view adds a viewport, a layout that fills `_blocks` with
    (rect, node, hue, depth) in screen pixels, and its painting."""
    focus_changed = Signal(object)       # emits the new focus Node
    selection_changed = Signal(object)   # emits the selected Node, or None
    cancel_requested = Signal()          # Esc while a scan is running


    def __init__(self):
        super().__init__()
        self.setMouseTracking(True)
        self.root = None
        self.focus = None
        self.scheme = DEFAULT_SCHEME
        self.relief = STYLES.index(DEFAULT_STYLE)   # 0 flat, 1 raised, 2 deep
        self.progress = None         # (path, entries, target, current, secs) while scanning
        self.empty_text = "No data."
        self.hovered = None
        self.selected = None
        self._blocks = []            # (QRectF, node, base_hue, depth)
        self._groups = {}            # (id(parent), first index) -> group Node
        self._prev_groups = {}       # same, from the previous frame
        self._color_cache = {}       # (id(node), hue, depth) -> base QColor
        self._ink_cache = {}         # rgb -> (ink, size ink, halo)
        self._anim = None            # running viewport animation, if any
        self._fade = None            # (snapshot pixmap, opacity) during a crossfade
        self._fade_anim = None
        self.pan_x = 0.0             # both views pan in pixels
        self.pan_y = 0.0
        self._press_pos = None
        self._drag_origin = None
        self._dragging = False
        # A real button over the painted scan panel; placed by _draw_progress.
        self._cancel_btn = QPushButton("Cancel", self)
        self._cancel_btn.setCursor(Qt.PointingHandCursor)
        self._cancel_btn.clicked.connect(self.cancel_requested)
        self._cancel_btn.hide()
        self.setMinimumSize(480, 320)
        self.setFocusPolicy(Qt.StrongFocus)


    def set_root(self, root):
        self.root = root
        self._stop_anim()
        self._stop_fade()
        self._groups = {}
        self._prev_groups = {}
        self._color_cache = {}
        self.set_focus(root)


    def set_focus(self, node):
        if node is None:
            return
        self.focus = node
        self.hovered = None
        self.set_selected(None)
        self.fit_view(redraw=False)
        self.focus_changed.emit(node)
        self.update()


    def set_progress(self, progress):
        """Show (or with None, hide) the scanning overlay."""
        self.progress = progress
        if progress is None:
            self._cancel_btn.hide()
        self.update()


    def set_scheme(self, scheme):
        if scheme not in COLOR_SCHEMES:
            raise ValueError(scheme)
        self.scheme = scheme
        self._color_cache = {}
        self.update()


    def set_style(self, style):
        if style not in STYLES:
            raise ValueError(style)
        self.relief = STYLES.index(style)
        self.update()

    @property
    def bevel(self):
        return self.relief > 0


    def _group_color(self, hue, depth, group):
        """Groups are the unresolved part of their branch: its colour, a
        little muted, under a dot stipple (see STIPPLE). Not a dark hole."""
        base = self._block_color(hue, depth, group, jitter=False)
        h = max(0.0, base.hslHueF())        # -1 for achromatic colours
        return QColor.fromHslF(h, base.hslSaturationF() * 0.8,
                               max(0.12, base.lightnessF() * 0.86))


    def set_selected(self, node):
        if node is self.selected:
            return
        self.selected = node
        self.selection_changed.emit(node)
        self.update()


    def go_up(self):
        if self.focus is not None and self.focus.parent is not None:
            self.navigate(self.focus.parent)
            return True
        return False

    # --- hooks a view implements ------------------------------------------
    def fit_view(self, redraw=True, animate=False):
        raise NotImplementedError

    def navigate(self, node):
        raise NotImplementedError

    def zoom_step(self, pos, factor):
        """Uniform zoom about `pos` by `factor` (keyboard +/-)."""
        raise NotImplementedError

    def _clamp_pan(self):
        raise NotImplementedError

    def _paint_content(self, p):
        """Lay the focus out into `_blocks` and draw it."""
        raise NotImplementedError

    def paintEvent(self, _event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing, False)
        p.fillRect(self.rect(), QColor("#1e1f22"))
        if self.focus is None:
            if self.progress is None:
                p.setPen(QColor("#888"))
                p.drawText(self.rect(), Qt.AlignCenter, self.empty_text)
            else:
                self._draw_progress(p)
            return
        self._paint_content(p)
        if self._fade is not None:
            snapshot, opacity = self._fade
            p.setOpacity(opacity)
            p.drawPixmap(0, 0, snapshot)
            p.setOpacity(1.0)
        if self.progress is not None:
            # Rescan: keep the old tree visible but clearly stale.
            p.fillRect(self.rect(), QColor(0, 0, 0, 120))
            self._draw_progress(p)
        p.end()

    def _base_color(self, node, hue, depth):
        """Unhovered colour of a block of any kind, cached per frame-stable key
        (groups are recreated on zoom, so their ids churn, but they are few)."""
        key = (id(node), hue, depth)
        color = self._color_cache.get(key)
        if color is None:
            if node.kind == "group":
                color = self._group_color(hue, depth, node)
            elif node.kind == "free":
                color = QColor("#e6e6e6" if self.scheme == "levels" else "#3a3d42")
            else:
                color = self._block_color(hue, depth, node)
            if len(self._color_cache) > 200000:
                self._color_cache.clear()
            self._color_cache[key] = color
        return color

    # Per relief level: (gradient light %, gradient dark %, edge px,
    # light edge alpha, dark edge alpha).
    RELIEF = ((100, 100, 1, 0, 60), (107, 109, 1, 85, 115), (115, 117, 2, 120, 150))

    def _fill_block(self, p, rect, color):
        """Flat or gradient fill, per the relief level."""
        if self.relief:
            lighter, darker = self.RELIEF[self.relief][:2]
            grad = QLinearGradient(rect.topLeft(), rect.bottomLeft())
            grad.setColorAt(0.0, color.lighter(lighter))
            grad.setColorAt(1.0, color.darker(darker))
            p.fillRect(rect, grad)
        else:
            p.fillRect(rect, color)

    def _draw_edges(self, p, rects, sunken=False):
        """Edges as fill strips: stroking a rect through the raster engine cost
        more than the whole rest of the frame once the layout itself got
        cheap, and fillRect is an order of magnitude faster. Raised: light
        top/left, dark bottom/right; sunken: the other way round."""
        _l, _d, px, la, da = self.RELIEF[self.relief]
        if not self.relief:
            if sunken:
                return          # flat: the children's own outlines suffice
            light = dark = QColor(0, 0, 0, da)
        else:
            light, dark = QColor(255, 255, 255, la), QColor(0, 0, 0, da)
            if sunken:
                light, dark = dark, light
        for r in rects:
            x0, y0, x1, y1 = r.left(), r.top(), r.right(), r.bottom()
            p.fillRect(QRectF(x0, y0, x1 - x0, px), light)
            p.fillRect(QRectF(x0, y0, px, y1 - y0), light)
            p.fillRect(QRectF(x0, y1 - px, x1 - x0, px), dark)
            p.fillRect(QRectF(x1 - px, y0, px, y1 - y0), dark)

    def _draw_selection(self, p, rect):
        pen = QPen(QColor("#ffffff"))
        pen.setWidth(2)
        p.setPen(pen)
        p.drawRect(rect.adjusted(1, 1, -1, -1))


    def _stop_anim(self):
        anim = self._anim
        if anim is not None:
            self._anim = None
            anim.stop()


    def _switch_focus(self, node):
        """set_focus with a crossfade from what was on screen."""
        self._stop_fade()
        snapshot = self.grab()
        self.set_focus(node)
        self._start_fade(snapshot)


    def _revalidate_groups(self):
        """Selection and hover may point at a group that this frame did not
        recreate (the tail starts at another index after a zoom). Move them
        to the group now standing under the same parent, or drop them."""
        for attr, signal in (("selected", self.selection_changed),
                             ("hovered", None)):
            node = getattr(self, attr)
            if node is None or node.kind != "group":
                continue
            if any(b[1] is node for b in self._blocks):
                continue
            repl = next(
                (b[1] for b in self._blocks
                 if b[1].kind == "group" and b[1].parent is node.parent), None
            )
            setattr(self, attr, repl)
            if signal is not None:
                signal.emit(repl)


    def _start_fade(self, snapshot):
        self._fade = (snapshot, 1.0)

        def step(t):
            if self._fade is None or self._fade_anim is not fade:
                return
            self._fade = (snapshot, 1.0 - float(t))
            if float(t) >= 1.0:
                self._fade = None
                self._fade_anim = None
            self.update()

        fade = QVariantAnimation(self)
        fade.setDuration(FADE_MS)
        fade.setStartValue(0.0)
        fade.setEndValue(1.0)
        fade.valueChanged.connect(step)
        self._fade_anim = fade
        fade.start(QVariantAnimation.DeleteWhenStopped)


    def _stop_fade(self):
        fade = self._fade_anim
        self._fade_anim = None
        self._fade = None
        if fade is not None:
            fade.stop()


    def _child_hue(self, base_hue, i, n, depth):
        """Hue for child `i` of `n` under a block of hue `base_hue`.

        branches: direct children of the focus fan out over the wheel, deeper
        levels inherit. rainbow: every level fans out again, starting at the
        parent's hue so the largest child looks like its parent.
        """
        if self.scheme == "rainbow":
            return (base_hue + i / max(1, n)) % 1.0
        fan_depth = 1 if self.focus is not None and self.focus.kind == "disk" else 0
        return (i / max(1, n)) if depth == fan_depth else base_hue


    @staticmethod
    def _is_top(node):
        """Root of the scan (the disk wrapper does not count as a parent)."""
        return node.parent is None or node.parent.kind == "disk"


    def _focus_hue(self):
        """Hue of the focus block: the colour it had as a child in its
        parent's view, so drilling in keeps the left column recognisable.
        rainbow derives it from the root chain; branches uses the position
        among its siblings. Ignored for the top node, which is drawn grey."""
        if self.focus is None:
            return 0.0
        if self.scheme == "branches":
            if self._is_top(self.focus):
                return 0.0
            siblings = self.focus.parent.children
            try:
                return siblings.index(self.focus) / max(1, len(siblings))
            except ValueError:
                return 0.0
        if self.scheme != "rainbow":
            return 0.0
        chain = []
        node = self.focus
        while node.parent is not None:
            chain.append(node)
            node = node.parent
        hue = 0.0
        for node in reversed(chain):
            siblings = node.parent.children
            try:
                i = siblings.index(node)
            except ValueError:   # synthetic group: no stable slot
                i = 0
            hue = (hue + i / max(1, len(siblings))) % 1.0
        return hue


    @staticmethod
    def _abs_depth(node):
        """Depth from the scanned root; the disk wrapper does not count."""
        d = 0
        while node.parent is not None and node.parent.kind != "disk":
            d += 1
            node = node.parent
        return d


    def _block_color(self, base_hue, depth, node=None, jitter=True):
        if self.scheme == "levels":
            if node is not None and node.kind == "disk":
                return QColor("#a9a9a9")   # a frame around the volume, not a level
            ad = self._abs_depth(node) if node is not None else depth
            return QColor(SPACEMONGER_PALETTE[ad % len(SPACEMONGER_PALETTE)])
        light = min(0.78, 0.42 + depth * 0.06)
        if jitter and node is not None and depth > 0:
            jitter = zlib.crc32(node.path.encode("utf-8", "surrogateescape"))
            light += (jitter / 0xFFFFFFFF * 2 - 1) * SHADE_JITTER
        if depth == 0:
            # The focus column is a frame, not data: muted, and plain grey at
            # the top where there is no parent view to echo.
            sat = 0.0 if node is not None and self._is_top(node) else 0.22
        else:
            sat = 0.48
        return QColor.fromHslF(base_hue % 1.0, sat, min(0.9, max(0.1, light)))


    def _ink(self, bg):
        """Cached per colour: a frame can ask for a thousand labels."""
        key = bg.rgb()
        ink = self._ink_cache.get(key)
        if ink is None:
            ink = self._ink_cache[key] = self._pick_ink(bg)
        return ink

    @staticmethod
    def _pick_ink(bg):
        """Label colours for a block: (name, size, halo), picked for contrast.

        Most blocks are light, so white-on-light text used to lean entirely on
        its outline to stay legible. Flipping the ink instead keeps the halo a
        faint backing rather than something that thickens every glyph.
        """
        def lin(v):
            return v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4

        lum = (0.2126 * lin(bg.redF()) + 0.7152 * lin(bg.greenF())
               + 0.0722 * lin(bg.blueF()))
        # 0.179 is where WCAG contrast against black and white is equal, so
        # the pick is always at least 4.58:1 and the halo can stay faint. It
        # only has to cover hovered blocks, which are drawn lighter.
        if lum > 0.179:
            return (QColor("#0a0a0a"), QColor("#2e2e2e"),
                    QColor(255, 255, 255, HALO_ALPHA))
        return QColor("#ffffff"), QColor("#e2e2e2"), QColor(0, 0, 0, HALO_ALPHA)


    @staticmethod
    def _draw_label(p, rect, flags, text, fg, halo):
        """Draw a label; with a halo colour, back it with a 1px outline first.

        The ink is picked for contrast against the block's own colour, so the
        halo is only needed where that colour is not what is on screen: the
        hovered block, drawn lighter. Five drawText calls per label instead of
        one were a measurable share of a frame."""
        if halo is not None:
            p.setPen(halo)
            for dx, dy in ((0, -1), (-1, 0), (1, 0), (0, 1)):
                p.drawText(rect.translated(dx, dy), flags, text)
        p.setPen(fg)
        p.drawText(rect, flags, text)


    def _draw_progress(self, p):
        path, entries, target, current, secs = self.progress
        fm = QFontMetrics(self.font())
        lh = fm.height()
        pad = 18
        pw = min(560, max(320, self.width() - 2 * pad))
        btn_h = self._cancel_btn.sizeHint().height()
        ph = pad * 2 + lh * 3 + 30 + btn_h + 10
        panel = QRectF((self.width() - pw) / 2, (self.height() - ph) / 2, pw, ph)
        p.setRenderHint(QPainter.Antialiasing, True)
        shape = QPainterPath()
        shape.addRoundedRect(panel, 8, 8)
        p.fillPath(shape, QColor("#2b2d31"))
        p.setPen(QPen(QColor("#4a4d55"), 1))
        p.drawPath(shape)

        inner = panel.adjusted(pad, pad, -pad, -pad)
        x, y, w = inner.left(), inner.top(), inner.width()
        p.setPen(QColor("#f0f0f0"))
        title = fm.elidedText(f"Scanning {path}", Qt.ElideMiddle, int(w))
        p.drawText(QRectF(x, y, w, lh), Qt.AlignLeft | Qt.AlignVCenter, title)
        y += lh + 6

        bar = QRectF(x, y, w, 10)
        track = QPainterPath()
        track.addRoundedRect(bar, 5, 5)
        p.fillPath(track, QColor("#1a1b1e"))
        p.setClipPath(track)
        if target:
            frac = min(0.995, entries / target)
            p.fillRect(QRectF(x, y, w * frac, 10), QColor("#5aa9e6"))
            status = f"{entries:,} of ~{target:,} entries  ({frac * 100:.0f}%)"
        else:
            # No target: a sweeping band driven by elapsed time so it moves
            # even while du is slow to produce the next lines.
            span = w * 0.3
            pos = (secs * 0.5) % 1.0 * (w + span) - span
            p.fillRect(QRectF(x + pos, y, span, 10), QColor("#5aa9e6"))
            status = f"{entries:,} entries"
        p.setClipping(False)
        y += 10 + 8

        p.setPen(QColor("#c8c8c8"))
        p.drawText(QRectF(x, y, w, lh), Qt.AlignLeft | Qt.AlignVCenter,
                   f"{status}    {secs:.0f}s")
        y += lh + 2
        p.setPen(QColor("#8a8f98"))
        cur = fm.elidedText(current or "", Qt.ElideMiddle, int(w))
        p.drawText(QRectF(x, y, w, lh), Qt.AlignLeft | Qt.AlignVCenter, cur)
        p.setRenderHint(QPainter.Antialiasing, False)
        btn = self._cancel_btn
        bw = btn.sizeHint().width()
        btn.setGeometry(int(inner.right() - bw), int(inner.bottom() - btn_h), bw, btn_h)
        if not btn.isVisible():
            btn.show()


    # --- hit testing / interaction ---------------------------------------
    def _node_at(self, pos):
        for rect, node, _hue, _depth in reversed(self._blocks):
            if rect.contains(pos):
                return node
        return None


    def mouseMoveEvent(self, event):
        if self._press_pos is not None and event.buttons() & (
            Qt.LeftButton | Qt.MiddleButton
        ):
            d = event.position() - self._press_pos
            if not self._dragging and abs(d.x()) + abs(d.y()) > DRAG_THRESHOLD:
                self._dragging = True
                self.setCursor(Qt.ClosedHandCursor)
            if self._dragging:
                self.pan_x = self._drag_origin[0] + d.x()
                self.pan_y = self._drag_origin[1] + d.y()
                self._clamp_pan()
                self.update()
                return
        node = self._node_at(event.position())
        if node is not self.hovered:
            self.hovered = node
            if node is not None:
                self.setToolTip(f"{node.name if node.synthetic else node.path}"
                                f"\n{human(node.size)}")
            else:
                self.setToolTip("")
            self.update()


    def mousePressEvent(self, event):
        if event.button() == Qt.RightButton:
            node = self._node_at(event.position())
            if node is not None:
                self._context_menu(node, event.globalPosition().toPoint())
            return
        if event.button() in (Qt.LeftButton, Qt.MiddleButton):
            self._stop_anim()
            self._press_pos = event.position()
            self._drag_origin = (self.pan_x, self.pan_y)
            self._dragging = False


    def mouseReleaseEvent(self, event):
        was_drag = self._dragging
        self._press_pos = None
        self._drag_origin = None
        self._dragging = False
        self.unsetCursor()
        if not was_drag and event.button() == Qt.LeftButton:
            self.set_selected(self._node_at(event.position()))


    def mouseDoubleClickEvent(self, event):
        if event.button() != Qt.LeftButton:
            return
        node = self._node_at(event.position())
        if node is None:
            return
        if node is self.focus:
            self.go_up()
        elif node.children:
            self.navigate(node)


    def _context_menu(self, node, global_pos):
        if node.kind == "disk":
            node = next((c for c in node.children if c.kind is None), node)
        if node.synthetic:
            return
        menu = QMenu(self)
        folder = node.path if node.children else os.path.dirname(node.path)
        act_open = QAction("Open in file manager", self)
        act_open.triggered.connect(lambda: _open_folder(folder))
        act_copy = QAction("Copy path", self)
        act_copy.triggered.connect(
            lambda: QGuiApplication.clipboard().setText(node.path)
        )
        menu.addAction(act_open)
        menu.addAction(act_copy)
        menu.exec(global_pos)


    def keyPressEvent(self, event):
        key = event.key()
        if key == Qt.Key_Escape and self.progress is not None:
            self.cancel_requested.emit()
        elif key in (Qt.Key_Backspace, Qt.Key_Escape):
            self.go_up()
        elif key in (Qt.Key_0, Qt.Key_Home):
            self.fit_view(animate=True)
        elif key in (Qt.Key_Plus, Qt.Key_Equal, Qt.Key_Minus):
            center = QPointF(self.width() / 2.0, self.height() / 2.0)
            f = 1.0 / KEY_ZOOM_STEP if key == Qt.Key_Minus else KEY_ZOOM_STEP
            self.zoom_step(center, f)
        else:
            super().keyPressEvent(event)


class IcicleWidget(TreeView):
    """Icicle view: horizontal columns, one per depth, sized by bytes."""

    def __init__(self):
        super().__init__()
        # Viewport. Layout happens in a logical space where the focus node is
        # LOGICAL_H tall and one column is LOGICAL_COLW wide; zx/zy/pan map it
        # to pixels. Blocks are laid out in screen pixels directly, so zooming
        # in subdivides deeper levels instead of just magnifying the same ones.
        self.zy = 0.0                # 0 until the first fit
        self.hx = 1.0                # horizontal offset on top of the damped zy
        self._max_depth = 1          # deepest column last frame, for pan limits
        self._more_right = False     # tree continues past the right edge
        self._last_h = 0             # widget height at the last layout


    # --- viewport ---------------------------------------------------------
    def _fit_zy(self):
        return max(1e-9, self.height() / LOGICAL_H)


    def _fit_zx(self):
        return max(COL_MIN, min(COL_MAX, self.width() / 7.0)) / LOGICAL_COLW


    def _raw_zx(self):
        return (
            self._fit_zx() * (self.zy / self._fit_zy()) ** H_ZOOM_DAMPING * self.hx
        )


    @property
    def zx(self):
        return max(
            COLW_MIN_PX / LOGICAL_COLW, min(COLW_MAX_PX / LOGICAL_COLW, self._raw_zx())
        )


    def fit_view(self, redraw=True, animate=False):
        """Reset the viewport so the focus node fills the widget."""
        self._stop_anim()
        if animate and self.zy > 0 and self.focus is not None:
            self._animate_to_fit()
            return
        self.zy = self._fit_zy()
        self.hx = 1.0
        self.pan_x = 0.0
        self.pan_y = 0.0
        self._last_h = self.height()
        if redraw:
            self.update()


    def _animate_to_fit(self, on_done=None):
        self._animate_view(self._fit_zy(), 1.0, 0.0, 0.0, on_done)


    def _animate_view(self, zy1, hx1, pan_x1, pan_y1, on_done=None):
        """Ease from the current viewport to the given one.

        Zoom is interpolated geometrically and the view is anchored on the
        logical point under the widget centre, so the motion reads as one
        smooth zoom-and-glide rather than the two axes racing each other.
        """
        w, h = self.width() / 2.0, self.height() / 2.0
        zx0, zy0 = self.zx, self.zy
        start = (
            math.log(zy0), math.log(max(1e-9, self.hx)),
            (w - self.pan_x) / zx0, (h - self.pan_y) / zy0,
        )
        # zx at the end state, with hx1 applied.
        hx_now, self.hx, self.zy = self.hx, hx1, zy1
        zx1 = self.zx
        self.hx, self.zy = hx_now, zy0
        end = (
            math.log(zy1), math.log(max(1e-9, hx1)),
            (w - pan_x1) / zx1, (h - pan_y1) / zy1,
        )

        def step(t):
            if self._anim is not anim:
                return
            u = float(t)
            lzy, lhx, cx, cy = (a + (b - a) * u for a, b in zip(start, end))
            self.zy = math.exp(lzy)
            self.hx = math.exp(lhx)
            self.pan_x = w - cx * self.zx
            self.pan_y = h - cy * self.zy
            self._last_h = self.height()
            if u >= 1.0:
                self.zy, self.hx = zy1, hx1
                self.pan_x, self.pan_y = pan_x1, pan_y1
                if on_done is not None:
                    # Runs while this animation still counts as active, so the
                    # snapshot it takes is this exact frame, not a re-clamped one.
                    on_done()
                if self._anim is anim:
                    self._anim = None
            self.update()

        anim = QVariantAnimation(self)
        anim.setDuration(NAV_ANIM_MS if on_done is not None else FIT_ANIM_MS)
        anim.setStartValue(0.0)
        anim.setEndValue(1.0)
        anim.setEasingCurve(QEasingCurve.InOutCubic if on_done else QEasingCurve.OutCubic)
        anim.valueChanged.connect(step)
        self._anim = anim
        anim.start(QVariantAnimation.DeleteWhenStopped)


    # --- animated navigation ----------------------------------------------
    def navigate(self, node):
        """Change focus with a zoom animation instead of a jump.

        Drilling in zooms the current view until the target block fills the
        widget, then switches focus; going up switches first and starts from
        the viewport in which the old focus fills the widget, then eases to
        the fit. The switch itself changes colours (the focus column is
        muted, branches re-fans hues), which a short crossfade covers.
        """
        if node is None or node is self.focus or self.focus is None:
            return
        if self.zy <= 0 or not self.isVisible():
            self.set_focus(node)
            return
        self._stop_anim()
        block = next((b for b in self._blocks if b[1] is node), None)
        if block is not None:
            rect, _n, _hue, depth = block
            ly = (rect.top() - self.pan_y) / self.zy
            lh = rect.height() / self.zy
            zy1 = self._fit_zy() * LOGICAL_H / lh
            hx1 = (zy1 / self._fit_zy()) ** -H_ZOOM_DAMPING
            colw_fit = self._fit_zx() * LOGICAL_COLW
            self._animate_view(
                zy1, hx1, -depth * colw_fit, -ly * zy1,
                on_done=lambda: self._switch_focus(node),
            )
            return
        place = self._place_within(self.focus, node)   # old focus inside the new
        if place is None:
            self._switch_focus(node)
            return
        # Reproduce the current viewport exactly inside the new focus's
        # coordinate space, so nothing moves at the switch, then ease out.
        ly, lh, depth = place
        zy_o, zx_o = self.zy, self.zx
        pan_x_o, pan_y_o = self.pan_x, self.pan_y
        self._switch_focus(node)
        self.zy = zy_o * LOGICAL_H / lh
        self.hx = zx_o / (self._fit_zx() * (self.zy / self._fit_zy()) ** H_ZOOM_DAMPING)
        self.pan_y = pan_y_o - ly * self.zy
        self.pan_x = pan_x_o - depth * zx_o * LOGICAL_COLW
        self._animate_to_fit()


    @staticmethod
    def _place_within(node, ancestor):
        """Logical (top, height, depth) of `node` laid out under `ancestor`,
        or None if it is not a descendant."""
        chain = []
        n = node
        while n is not None and n is not ancestor:
            chain.append(n)
            n = n.parent
        if n is None:
            return None
        top, height = 0.0, LOGICAL_H
        for child in reversed(chain):
            parent = child.parent
            total = parent.size or 1
            first = child.children[0] if child.kind == "group" and child.children else child
            before = 0
            for sib in parent.children:
                if sib is first:
                    break
                before += sib.size
            top += height * before / total
            height *= child.size / total
        return top, height, len(chain)


    def _zoom_in_limit(self):
        """How far past the fit zoom it is still useful to go, as a factor."""
        if self.focus is None or self.focus.size <= 0:
            return ZOOM_IN_CAP
        return max(4.0, min(ZOOM_IN_CAP, self.focus.size / ZOOM_IN_UNIT))


    def _clamp_zoom(self):
        fz = self._fit_zy()
        self.zy = max(fz * ZOOM_OUT_LIMIT, min(fz * self._zoom_in_limit(), self.zy))


    def _clamp_pan(self):
        """No empty margins: content larger than the widget can be panned
        until its far edge meets the widget's; smaller content stays put at
        the top/left. Continuous in the zoom level (both bounds are 0 where
        the content just fits), so nothing snaps on a wheel notch."""
        w, h = float(self.width()), float(self.height())
        total_h = LOGICAL_H * self.zy
        self.pan_y = min(0.0, max(min(0.0, h - total_h), self.pan_y))
        total_w = max(1, self._max_depth) * LOGICAL_COLW * self.zx
        if self._more_right:
            total_w += w
        self.pan_x = min(0.0, max(min(0.0, w - total_w), self.pan_x))


    def _zoom_at(self, pos, fy, fh=1.0):
        """Scale about `pos`, keeping whatever is under the cursor in place.

        `fy` scales the vertical zoom (and, damped, the column width with it);
        `fh` scales the extra horizontal offset on top of that.
        """
        if self.zy <= 0:
            self.fit_view(redraw=False)
        old_zx, old_zy = self.zx, self.zy
        self.zy *= fy
        self.hx *= fh
        self._clamp_zoom()
        if fh != 1.0:
            # A one-axis change past the width limits would otherwise leave a
            # dead zone to wind back through. Plain zoom must not do this: its
            # raw width has to keep tracking zy so zooming back out restores
            # the fit width even after both axes sat on their limits.
            self.hx *= self.zx / self._raw_zx()
        self.pan_x = pos.x() - (pos.x() - self.pan_x) * (self.zx / old_zx)
        self.pan_y = pos.y() - (pos.y() - self.pan_y) * (self.zy / old_zy)
        self._clamp_pan()
        self.update()


    def zoom_step(self, pos, factor):
        self._zoom_at(pos, factor)

    def wheelEvent(self, event):
        self._stop_anim()
        dy = event.angleDelta().y()
        if dy == 0:
            dy = event.pixelDelta().y() * 3
        if dy == 0:
            return
        factor = ZOOM_STEP ** dy
        mods = event.modifiers()
        # Shift: vertical only (sizes), Ctrl: horizontal only (depth).
        if mods & Qt.ControlModifier:
            fy, fh = 1.0, factor
        elif mods & Qt.ShiftModifier:
            fy, fh = factor, factor ** -H_ZOOM_DAMPING   # cancel the coupling
        else:
            fy, fh = factor, 1.0
        self._zoom_at(event.position(), fy, fh)
        event.accept()


    # --- layout -----------------------------------------------------------
    def _layout(self, node, x, y, h, depth, base_hue, colw, in_group):
        w, hgt = float(self.width()), float(self.height())
        if y >= hgt or y + h <= 0 or x >= w:
            return          # off-screen; nothing below this node can be visible
        if x + colw > 0:    # columns past the left edge still have visible children
            self._blocks.append((QRectF(x, y, colw, h), node, base_hue, depth))
            if depth + 1 > self._max_depth:
                self._max_depth = depth + 1
        # Inside an already-aggregated group, pack children down to a 1px floor
        # instead of re-aggregating, so a group never nests into itself.
        floor = 1.0 if in_group else MIN_BLOCK_PX
        if h < floor or not node.children or x + colw >= w:
            if node.children and x + colw >= w:
                # Cut off by the right edge, so panning must be allowed to
                # bring it in: the visible depth alone would pin pan_x here.
                self._more_right = True
            return
        cy = y
        total = node.size or 1
        children = node.children
        n = len(children)
        i = 0
        drawn = 0
        truncated = False
        while i < n:
            child = children[i]
            ch = h * (child.size / total)
            if ch < floor:
                break   # children are sorted desc, so the rest are tiny too
            if cy >= hgt:
                truncated = True   # and so is everything after it
                break
            if cy + ch > 0:
                child_hue = self._child_hue(base_hue, i, n, depth)
                self._layout(
                    child, x + colw, cy, ch, depth + 1, child_hue, colw, in_group
                )
            cy += ch
            drawn += child.size
            i += 1

        # Coalesce the too-small tail into one drillable aggregate block that
        # fills the leftover band, instead of leaving it blank.
        leftover_h = (y + h) - cy
        if (
            not in_group
            and not truncated
            and i < n
            and leftover_h >= MIN_BLOCK_PX
            and x + colw < w
        ):
            # Reuse last frame's group for the same tail: it keeps the
            # children slice from being copied every frame and keeps the
            # object identity that hover/selection compare against.
            key = (id(node), i)
            group = self._prev_groups.get(key)
            if group is None:
                group = Node(
                    f"{n - i} smaller items", node.children_size - drawn,
                    kind="group",
                )
                group.children = children[i:]
                group.parent = node
            self._groups[key] = group
            grect = QRectF(x + colw, cy, colw, leftover_h)
            # Coloured like its first member, which is what it stands in for.
            group_hue = self._child_hue(base_hue, i, n, depth)
            self._blocks.append((grect, group, group_hue, depth + 1))


    # --- painting ---------------------------------------------------------
    def _paint_content(self, p):
        if self.zy <= 0:
            self.fit_view(redraw=False)
        elif self._last_h and self._last_h != self.height():
            # Keep the same slice of the tree in view when the window resizes.
            f = self.height() / self._last_h
            self.zy *= f
            self.pan_y *= f
        self._last_h = self.height()

        colw = LOGICAL_COLW * self.zx
        self._prev_groups = self._groups
        for _attempt in range(2):
            self._blocks = []
            self._groups = {}
            self._max_depth = 1
            self._more_right = False
            self._layout(
                self.focus, self.pan_x, self.pan_y, LOGICAL_H * self.zy, 0,
                self._focus_hue(), colw, self.focus.is_group,
            )
            # The horizontal bound depends on the visible depth, which is only
            # known after layout; re-clamp with fresh numbers and lay out again
            # if that moved the view, instead of trusting the previous frame.
            if self._anim is not None:
                break           # animation frames are already valid views
            pan = (self.pan_x, self.pan_y)
            self._clamp_pan()
            if (self.pan_x, self.pan_y) == pan:
                break

        self._revalidate_groups()
        view = QRectF(self.rect())
        fm = QFontMetrics(self.font())
        outlines = []
        labels = []          # (vis rect, node, base colour, ink, ink_size, halo)
        selected_rect = None
        for rect, node, base_hue, depth in self._blocks:
            # A zoomed-in block can be millions of pixels tall; clip it to the
            # viewport so both the fill and its labels stay on screen.
            vis = rect.intersected(view)
            if vis.width() < 1 or vis.height() < 1:
                continue
            hovered = node is self.hovered
            base = self._base_color(node, base_hue, depth)
            color = base.lighter(118 if node.is_group else 122) if hovered else base
            self._fill_block(p, vis, color)
            if node.is_group:
                p.fillRect(vis, _stipple())   # texture marks it as grouped
            outlines.append(vis)
            if node is self.selected:
                selected_rect = vis
            if vis.height() >= fm.height() + 3 and vis.width() > 34:
                # Ink comes from the unhovered colour so it cannot flip on
                # hover; only labelled blocks need it computed at all.
                ink, ink_size, halo = self._ink(base)
                labels.append((vis, node, base, ink, ink_size,
                               halo if hovered else None))

        self._draw_edges(p, outlines)
        if selected_rect is not None:
            self._draw_selection(p, selected_rect)

        for vis, node, base, ink, ink_size, halo in labels:
            inner = vis.adjusted(6, 2, -6, -2)
            label = node.name
            two_lines = vis.height() >= 2 * fm.height() + 4
            if node.is_group:
                label = "▸ " + label
            name = fm.elidedText(label, Qt.ElideMiddle, int(inner.width()))
            if node.is_group:
                # Text over the stipple, lighter still on hover, was barely
                # legible: give each label line a solid backing in the
                # group's own colour so the ink always sits on plain ground.
                backing = QColor(base)
                backing.setAlpha(235)
                tw = fm.horizontalAdvance(name)
                p.fillRect(QRectF(inner.left() - 3, inner.top(), tw + 6,
                                  fm.height()), backing)
                if two_lines:
                    size_txt = human(node.size)
                    tw = fm.horizontalAdvance(size_txt)
                    p.fillRect(QRectF(inner.left() - 3,
                                      inner.bottom() - fm.height(), tw + 6,
                                      fm.height()), backing)
            self._draw_label(
                p, inner, Qt.AlignLeft | Qt.AlignTop, name, ink, halo
            )
            if two_lines:
                self._draw_label(
                    p, inner, Qt.AlignLeft | Qt.AlignBottom,
                    human(node.size), ink_size, halo,
                )

class Squarifier:
    """Incremental squarified treemap (Bruls, Huizing, van Wijk) of a
    directory's children, sorted descending, into a box of the given aspect
    ratio (normalised: width = aspect, height = 1).

    Rows are laid out along the shorter side of what is left, adding items
    while the worst aspect ratio in the row keeps improving. A finished row
    never changes when later rows are added, so the layout can stop at the
    first item too small to draw and be extended when a deeper zoom needs
    more, with everything already placed staying put. Memory follows what is
    on screen, not the size of the directory."""
    __slots__ = ("children", "scale", "aspect", "x", "y", "w", "h", "i", "idx", "geo",
                 "rows", "rowgeo")

    def __init__(self, children, total, aspect):
        self.children = children
        self.scale = aspect / float(total or 1)      # normalised area per byte
        self.aspect = aspect
        self.x = self.y = 0.0
        self.w, self.h = aspect, 1.0
        self.i = 0
        # Compact: a child index and four fractions (x, y, w, h of the box)
        # per entry, 36 bytes instead of a 200-byte tuple; a 190k-entry
        # directory then costs 7 MB, not 40.
        self.idx = array.array("I")
        self.geo = array.array("d")
        # Row strips: first entry index and x, y, w, h of each row, so the
        # layout loop can skip a whole off-screen row at once.
        self.rows = array.array("I")
        self.rowgeo = array.array("d")

    def __len__(self):
        return len(self.idx)

    def extend(self, min_area):
        """Lay out further rows until the next item is below `min_area`
        (normalised units) or the children run out."""
        children, scale, aspect = self.children, self.scale, self.aspect
        n = len(children)
        x, y, w, h, i = self.x, self.y, self.w, self.h, self.i
        idx, geo, rows, rowgeo = self.idx, self.geo, self.rows, self.rowgeo
        while i < n and children[i].size * scale >= min_area:
            side = min(w, h)
            if side <= 1e-12:
                i = n
                break
            row_sum = row_max = row_min = children[i].size * scale
            j = i + 1
            side2 = side * side

            def worst(s, mx, mn):
                return max(side2 * mx / (s * s), s * s / (side2 * mn)) if mn > 0 else float("inf")

            best = worst(row_sum, row_max, row_min)
            while j < n:
                a = children[j].size * scale
                s2 = row_sum + a
                w2 = worst(s2, row_max, min(row_min, a))
                if w2 > best:
                    break
                row_sum, row_min, best = s2, min(row_min, a), w2
                j += 1
            thick = row_sum / side
            rows.append(len(idx))
            if w >= h:      # vertical strip on the left
                rowgeo.extend((x / aspect, y, thick / aspect, h))
                cy = y
                for k in range(i, j):
                    ch = children[k].size * scale / thick
                    if ch > 0:
                        idx.append(k)
                        geo.extend((x / aspect, cy, thick / aspect, ch))
                    cy += ch
                x += thick
                w -= thick
            else:           # horizontal strip on top
                rowgeo.extend((x / aspect, y, w / aspect, thick))
                cx = x
                for k in range(i, j):
                    cw = children[k].size * scale / thick
                    if cw > 0:
                        idx.append(k)
                        geo.extend((cx / aspect, y, cw / aspect, thick))
                    cx += cw
                y += thick
                h -= thick
            i = j
        self.x, self.y, self.w, self.h, self.i = x, y, w, h, i


class BoxesWidget(TreeView):
    """SpaceMonger-style view: the focus is a box filling the widget, every
    directory inside it a titled box with its children packed inside by a
    squarified treemap, recursively while there is room."""

    def __init__(self):
        super().__init__()
        self.s = 0.0                 # uniform scale, 1.0 = fit; 0 until the first fit
        self._info = []              # per block: title bar height (0 = none)
        # Layouts are decided once per directory in normalised coordinates
        # and only scaled afterwards, so zooming never rearranges anything;
        # the screen size decides what is drawn, not where it goes.
        self._layouts = {}           # id(dir) -> Squarifier (laid out as far as needed)
        self._layout_entries = 0

    def set_root(self, root):
        self._layouts = {}
        self._layout_entries = 0
        super().set_root(root)

    def set_focus(self, node):
        self._layouts = {}           # boxes take the aspect they get under this focus
        self._layout_entries = 0
        super().set_focus(node)

    def resizeEvent(self, event):
        self._layouts = {}
        self._layout_entries = 0
        super().resizeEvent(event)

    # --- viewport ---------------------------------------------------------
    def fit_view(self, redraw=True, animate=False):
        self._stop_anim()
        if animate and self.s > 0 and self.focus is not None:
            self._animate_view(1.0, 0.0, 0.0)
            return
        self.s = 1.0
        self.pan_x = self.pan_y = 0.0
        if redraw:
            self.update()

    def _zoom_in_limit(self):
        if self.focus is None or self.focus.size <= 0:
            return ZOOM_IN_CAP
        return max(4.0, min(ZOOM_IN_CAP, self.focus.size / ZOOM_IN_UNIT))

    def _clamp_pan(self):
        """The focus box always covers the widget (zoom-out stops at the fit)."""
        w, h = float(self.width()), float(self.height())
        for attr, extent, span in (("pan_x", w * self.s, w), ("pan_y", h * self.s, h)):
            setattr(self, attr, min(0.0, max(span - extent, getattr(self, attr))))

    def _zoom_at(self, pos, factor):
        if self.s <= 0:
            self.fit_view(redraw=False)
        old = self.s
        self.s = max(BOX_ZOOM_OUT_LIMIT, min(self._zoom_in_limit(), self.s * factor))
        k = self.s / old
        self.pan_x = pos.x() - (pos.x() - self.pan_x) * k
        self.pan_y = pos.y() - (pos.y() - self.pan_y) * k
        self._clamp_pan()
        self.update()

    def zoom_step(self, pos, factor):
        self._zoom_at(pos, factor)

    def wheelEvent(self, event):
        self._stop_anim()
        dy = event.angleDelta().y()
        if dy == 0:
            dy = event.pixelDelta().y() * 3
        if dy == 0:
            return
        self._zoom_at(event.position(), ZOOM_STEP ** dy)
        event.accept()

    def _animate_view(self, s1, pan_x1, pan_y1, on_done=None):
        """Geometric zoom interpolation anchored on the widget centre."""
        w, h = self.width() / 2.0, self.height() / 2.0
        s0 = self.s
        start = (math.log(s0), (w - self.pan_x) / s0, (h - self.pan_y) / s0)
        end = (math.log(s1), (w - pan_x1) / s1, (h - pan_y1) / s1)

        def step(t):
            if self._anim is not anim:
                return
            u = float(t)
            ls, cx, cy = (a + (b - a) * u for a, b in zip(start, end))
            self.s = math.exp(ls)
            self.pan_x = w - cx * self.s
            self.pan_y = h - cy * self.s
            if u >= 1.0:
                self.s = s1
                self.pan_x, self.pan_y = pan_x1, pan_y1
                if on_done is not None:
                    on_done()
                if self._anim is anim:
                    self._anim = None
            self.update()

        anim = QVariantAnimation(self)
        anim.setDuration(NAV_ANIM_MS if on_done is not None else FIT_ANIM_MS)
        anim.setStartValue(0.0)
        anim.setEndValue(1.0)
        anim.setEasingCurve(QEasingCurve.InOutCubic if on_done else QEasingCurve.OutCubic)
        anim.valueChanged.connect(step)
        self._anim = anim
        anim.start(QVariantAnimation.DeleteWhenStopped)

    def _cover_view(self, rect):
        """(s, pan_x, pan_y) that scales the current view so `rect` covers the
        widget, centred. Cover rather than contain: a tall narrow box then
        really zooms in instead of just sliding to the middle, and the fit
        layout that follows re-packs its contents anyway."""
        w, h = float(self.width()), float(self.height())
        k = max(w / max(1.0, rect.width()), h / max(1.0, rect.height()))
        s1 = self.s * k
        cx, cy = rect.center().x(), rect.center().y()
        return s1, w / 2 - (cx - self.pan_x) * k, h / 2 - (cy - self.pan_y) * k

    def navigate(self, node):
        if node is None or node is self.focus or self.focus is None:
            return
        if self.s <= 0 or not self.isVisible():
            self.set_focus(node)
            return
        self._stop_anim()
        block = next((b for b in self._blocks if b[1] is node), None)
        if block is not None:
            s1, px, py = self._cover_view(block[0])
            self._animate_view(s1, px, py, on_done=lambda: self._switch_focus(node))
            return
        old = self.focus
        self._switch_focus(node)
        # Where does the old focus sit in the new focus's fit layout? Start
        # the view zoomed onto it and ease out to the fit.
        blocks, info = self._blocks, self._info
        self._blocks, self._info = [], []
        self._th, self._view = self._title_height(), QRectF(self.rect())
        self._floor_area = max(MIN_BOX_PX * MIN_BOX_PX,
                               self.width() * self.height() / BOX_BUDGET)
        self._layout_box(node, QRectF(0, 0, self.width(), self.height()), 0,
                         self._focus_hue())
        place = next((b[0] for b in self._blocks if b[1] is old), None)
        self._blocks, self._info = blocks, info
        if place is None:
            return
        self.s, self.pan_x, self.pan_y = self._cover_view(place)
        self._animate_view(1.0, 0.0, 0.0)

    # --- layout -----------------------------------------------------------
    def _title_height(self):
        return QFontMetrics(self.font()).height() + 2 * BOX_TITLE_PAD

    def _revalidate_groups(self):
        """Groups are permanent here (one per directory), so a selected one
        that is off screen or below the size floor is still valid."""

    def _dir_layout(self, node, rect, min_frac):
        """Layout entries of a directory's children, laid out at least as far
        as items covering `min_frac` of the box (the on-screen size floor).

        Computed for the aspect the box has when first seen under the current
        focus and then kept until the focus or the widget size changes. Title
        bars and insets are fixed pixels, so a box's content aspect drifts as
        you zoom; recomputing for it would reflow the children. Squarify sees
        a slightly stale aspect instead, which costs a little squareness and
        no stability. The cache is dropped wholesale past LAYOUT_BUDGET
        entries; layouts are deterministic, so that changes nothing."""
        sq = self._layouts.get(id(node))
        if sq is None:
            aspect = rect.width() / max(1e-9, rect.height())
            sq = Squarifier(node.children, node.children_size, aspect)
            if self._layout_entries > LAYOUT_BUDGET:
                self._layouts = {}
                self._layout_entries = 0
            self._layouts[id(node)] = sq
        before = len(sq)
        sq.extend(min_frac * sq.aspect)
        self._layout_entries += len(sq) - before
        return sq

    def _layout_box(self, node, rect, depth, hue):
        if not rect.intersects(self._view):
            return
        th = self._th
        open_children = bool(node.children)
        titled = (open_children
                  and rect.height() >= th + 2 * MIN_BOX_PX and rect.width() >= 40)
        self._blocks.append((rect, node, hue, depth))
        # Per block: title bar height, 0 for a leaf-like box (centred label),
        # or -1 for an untitled box whose children fill it (no label at all,
        # they would land on top of the children's).
        info_idx = len(self._info)
        self._info.append(th if titled else 0.0)
        if not open_children:
            return
        top = th if titled else BOX_INSET
        inner = QRectF(rect.x() + BOX_INSET, rect.y() + top,
                       rect.width() - 2 * BOX_INSET, rect.height() - top - BOX_INSET)
        if inner.width() < MIN_BOX_PX or inner.height() < MIN_BOX_PX:
            return
        ix, iy, iw, ih = inner.x(), inner.y(), inner.width(), inner.height()
        floor_area = self._floor_area
        layout = self._dir_layout(node, rect, floor_area / (iw * ih))
        children = node.children
        n = len(children)
        laid = 0
        vx0, vy0 = self._view.left(), self._view.top()
        vx1, vy1 = self._view.right(), self._view.bottom()
        idx, geo, rows, rowgeo = layout.idx, layout.geo, layout.rows, layout.rowgeo
        total_entries = len(idx)
        for r in range(len(rows)):
            start = rows[r]
            end = rows[r + 1] if r + 1 < len(rows) else total_entries
            if start >= end:
                continue
            g = 4 * start
            if geo[g + 2] * iw * geo[g + 3] * ih < floor_area:
                break       # rows are sorted by size too: the rest is smaller
            rg = 4 * r
            rx, ry = ix + rowgeo[rg] * iw, iy + rowgeo[rg + 1] * ih
            rw, rh = rowgeo[rg + 2] * iw, rowgeo[rg + 3] * ih
            if rx > vx1 or ry > vy1 or rx + rw < vx0 or ry + rh < vy0:
                continue    # whole row off screen
            for k in range(start, end):
                g = 4 * k
                w, h = geo[g + 2] * iw, geo[g + 3] * ih
                if w * h < floor_area:
                    break
                if w < 1 or h < 1:
                    continue
                x, y = ix + geo[g] * iw, iy + geo[g + 1] * ih
                if x > vx1 or y > vy1 or x + w < vx0 or y + h < vy0:
                    continue
                j = idx[k]
                self._layout_box(children[j], QRectF(x, y, w, h),
                                 depth + 1, self._child_hue(hue, j, n, depth))
                laid += 1
        if laid and not titled:
            self._info[info_idx] = -1.0

    # --- painting ---------------------------------------------------------
    def _paint_content(self, p):
        if self.s <= 0:
            self.fit_view(redraw=False)
        w, h = float(self.width()), float(self.height())
        self._th, self._view = self._title_height(), QRectF(self.rect())
        self._floor_area = max(MIN_BOX_PX * MIN_BOX_PX, w * h / BOX_BUDGET)
        for _attempt in range(2):
            self._blocks, self._info = [], []
            self._layout_box(
                self.focus, QRectF(self.pan_x, self.pan_y, w * self.s, h * self.s),
                0, self._focus_hue(),
            )
            if self._anim is not None:
                break
            pan = (self.pan_x, self.pan_y)
            self._clamp_pan()
            if (self.pan_x, self.pan_y) == pan:
                break
        self._revalidate_groups()

        view = QRectF(self.rect())
        fm = QFontMetrics(self.font())
        lh = fm.height()
        edges = []
        wells = []           # content areas of open directories, drawn sunken
        labels = []          # (vis, rect, node, title_h, base, ink, ink_size, halo)
        selected_rect = None
        # Anchor the dots to the content so they move with it when panning.
        # Done on the brush itself: QPainter.setBrushOrigin would shift the
        # gradients too, and a large pan then paints every block in its
        # gradient's end colour.
        stipple = QBrush(_stipple())
        stipple.setTransform(QTransform.fromTranslate(self.pan_x % 6, self.pan_y % 6))
        for (rect, node, hue, depth), th in zip(self._blocks, self._info):
            vis = rect.intersected(view)
            if vis.width() < 1 or vis.height() < 1:
                continue
            hovered = node is self.hovered
            base = self._base_color(node, hue, depth)
            color = base.lighter(118 if node.is_group else 112) if hovered else base
            small = vis.width() < SMALL_BOX_PX or vis.height() < SMALL_BOX_PX
            if node.is_group:
                # Sunken, stippled, flat: the unresolved rest of the parent.
                p.fillRect(vis, color)
                p.fillRect(vis, stipple)
                if not small:
                    wells.append(vis)
            elif small:
                p.fillRect(vis, color)      # too small for relief to register
            elif th != 0:
                # A directory's body is covered by its children; a gradient
                # over the whole box at every nesting level would repaint the
                # screen area once per depth. Flat body, relief on the bar.
                p.fillRect(vis, color)
                if th > 0:
                    bar = QRectF(rect.x(), rect.y(), rect.width(), th).intersected(view)
                    if bar.height() >= 1:
                        self._fill_block(p, bar, color)
                edges.append(vis)
            else:
                self._fill_block(p, vis, color)
                edges.append(vis)
            if th != 0 and not small and not node.is_group:
                top = th if th > 0 else BOX_INSET
                well = QRectF(rect.x() + BOX_INSET - 1, rect.y() + top - 1,
                              rect.width() - 2 * BOX_INSET + 2,
                              rect.height() - top - BOX_INSET + 2).intersected(view)
                if well.width() > 2 and well.height() > 2:
                    wells.append(well)
                    # Whatever the children do not cover is content too small
                    # to lay out: show it as stipple, SpaceMonger 2 style.
                    p.fillRect(well.adjusted(1, 1, -1, -1), stipple)
            if node is self.selected:
                selected_rect = vis
            if th > 0 or (th == 0 and vis.height() >= lh + 4 and vis.width() >= 40):
                ink, ink_size, halo = self._ink(base)
                labels.append((vis, rect, node, th, base, ink, ink_size,
                               halo if hovered else None))
        self._draw_edges(p, edges)
        # Sunken frame around each directory's content area: parent/child
        # boundaries then read dark-then-light exactly like the boundary
        # between two sibling boxes, instead of a lone light line.
        self._draw_edges(p, wells, sunken=True)
        if selected_rect is not None:
            self._draw_selection(p, selected_rect)

        for vis, rect, node, th, base, ink, ink_size, halo in labels:
            name = node.name
            if th > 0:
                # Title bar: name left, size right when both fit. The bar
                # scrolls with the box but is clipped to the visible part.
                bar = QRectF(rect.x(), rect.y(), rect.width(), th).intersected(view)
                if bar.height() < lh:
                    continue
                inner = bar.adjusted(BOX_INSET + 2, 0, -(BOX_INSET + 2), 0)
                size_txt = human(node.size)
                size_w = fm.horizontalAdvance(size_txt)
                name_room = inner.width()
                show_size = inner.width() > size_w + 60
                if show_size:
                    name_room -= size_w + 12
                text = self._fit_name(fm, node, name, name_room)
                self._draw_label(p, inner, Qt.AlignLeft | Qt.AlignVCenter, text, ink, halo)
                if show_size:
                    self._draw_label(p, inner, Qt.AlignRight | Qt.AlignVCenter,
                                     size_txt, ink_size, halo)
            else:
                # Leaf (or a directory too small to open): centred labels.
                inner = vis.adjusted(4, 2, -4, -2)
                text = self._fit_name(fm, node, name, inner.width())
                two = inner.height() >= 2 * lh + 2
                if two:
                    top = QRectF(inner.x(), inner.center().y() - lh, inner.width(), lh)
                    bottom = QRectF(inner.x(), inner.center().y(), inner.width(), lh)
                    self._draw_label(p, top, Qt.AlignCenter, text, ink, halo)
                    self._draw_label(p, bottom, Qt.AlignCenter, human(node.size),
                                     ink_size, halo)
                else:
                    self._draw_label(p, inner, Qt.AlignCenter, text, ink, halo)

    @staticmethod
    def _fit_name(fm, node, name, room):
        """Elide a name into `room` px. A group label degrades in steps,
        "▸ 173 smaller items" -> "▸ 173" -> "▸", since an elided middle of
        it would be noise while the count is the useful part."""
        if not node.is_group:
            return fm.elidedText(name, Qt.ElideMiddle, int(room))
        for text in ("▸ " + name, "▸ " + name.split(" ")[0], "▸"):
            if fm.horizontalAdvance(text) <= room:
                return text
        return ""


def list_volumes():
    """Mounted real filesystems: [(device, mount, fstype, total, used, free)],
    biggest first. Pseudo filesystems (proc, sys, cgroup, tmpfs...) are left
    out; anything on a /dev node or a network share is in."""
    seen = {}
    try:
        with open("/proc/mounts", "rb") as f:
            lines = f.read().split(b"\n")
    except OSError:
        return []
    net = {b"nfs", b"nfs4", b"cifs", b"smb3", b"fuse.sshfs", b"zfs", b"fuse.rclone"}
    for line in lines:
        parts = line.split()
        if len(parts) < 3:
            continue
        device, mount, fstype = parts[0], _unescape_mount(parts[1]), parts[2]
        if not (device.startswith(b"/dev/") or fstype in net):
            continue
        if fstype in (b"squashfs", b"iso9660", b"udf", b"fuse.gvfsd-fuse"):
            continue
        try:
            st = os.statvfs(mount)
        except OSError:
            continue
        total = st.f_blocks * st.f_frsize
        if total <= 0:
            continue
        free = st.f_bavail * st.f_frsize
        seen[mount] = (_unescape_mount(device), mount, fstype.decode("ascii", "replace"),
                       total, total - free, free)    # later lines win
    return sorted(seen.values(), key=lambda v: v[3], reverse=True)



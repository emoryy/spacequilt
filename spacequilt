class Breadcrumb(QWidget):
    """A row of clickable buttons for the path from root to focus."""

    def __init__(self, icicle):
        super().__init__()
        self.icicle = icicle
        self._layout = QHBoxLayout(self)
        self._layout.setContentsMargins(6, 4, 6, 4)
        self._layout.setSpacing(2)
        self._layout.addStretch()

    def rebuild(self, focus):
        while self._layout.count():
            item = self._layout.takeAt(0)
            w = item.widget()
            if w is not None:
                w.deleteLater()
        chain = []
        node = focus
        while node is not None:
            chain.append(node)
            node = node.parent
        chain.reverse()
        for i, node in enumerate(chain):
            btn = QPushButton(node.name or "/")
            btn.setFlat(True)
            btn.setCursor(Qt.PointingHandCursor)
            btn.clicked.connect(lambda _=False, n=node: self.icicle.navigate(n))
            self._layout.addWidget(btn)
            if i < len(chain) - 1:
                sep = QLabel("›")
                sep.setStyleSheet("color:#777;")
                self._layout.addWidget(sep)
        self._layout.addStretch()


class MainWindow(QMainWindow):
    def __init__(self, path, one_fs, scheme=None, style=None):
        super().__init__()
        self.one_fs = one_fs
        self.settings = QSettings("spacequilt", "spacequilt")
        if scheme is None:
            scheme = self.settings.value("colors", DEFAULT_SCHEME)
            if scheme not in COLOR_SCHEMES:
                scheme = DEFAULT_SCHEME
        if style is None:
            style = self.settings.value("style", DEFAULT_STYLE)
            if style not in STYLES:
                style = DEFAULT_STYLE
        self.scanner = None
        self._stopping = []          # scanners still winding down
        self._progress_timer = QTimer(self)
        self._progress_timer.setInterval(100)
        self._progress_timer.timeout.connect(self._poll_progress)
        self._selected = None
        self._current_path = os.path.abspath(path)
        self.setWindowTitle("spacequilt")
        self.resize(1000, 640)
        geometry = self.settings.value("window/geometry")
        if geometry is not None:
            # Size, maximised state and screen; Wayland compositors ignore
            # the position part and place the window themselves.
            self.restoreGeometry(geometry)

        self.icicle = IcicleWidget()
        self.icicle.set_scheme(scheme)
        self.icicle.set_bevel(style == "bevel")
        self.breadcrumb = Breadcrumb(self.icicle)
        self.icicle.focus_changed.connect(self._on_focus)
        self.icicle.selection_changed.connect(self._on_selection)
        self.icicle.cancel_requested.connect(self.cancel_scan)

        central = QWidget()
        v = QVBoxLayout(central)
        v.setContentsMargins(0, 0, 0, 0)
        v.setSpacing(0)
        v.addWidget(self.breadcrumb)
        v.addWidget(self.icicle, 1)
        self.setCentralWidget(central)

        tb = self.addToolBar("main")
        tb.setMovable(False)
        tb.setToolButtonStyle(Qt.ToolButtonTextBesideIcon)
        act_open = QAction(self._icon("open"), "Open…", self)
        act_open.setShortcut("Ctrl+O")
        act_open.triggered.connect(self._pick_dir)
        act_rescan = QAction(self._icon("rescan"), "Rescan", self)
        act_rescan.setShortcut("Ctrl+R")
        act_rescan.triggered.connect(self._rescan)
        self.act_stop = QAction(self._icon("stop"), "Stop", self)
        self.act_stop.setToolTip("Cancel the running scan (Esc)")
        self.act_stop.setEnabled(False)
        self.act_stop.triggered.connect(self.cancel_scan)
        self.act_one_fs = QAction(self._icon("drive"), "One filesystem", self)
        self.act_one_fs.setCheckable(True)
        self.act_one_fs.setChecked(one_fs)
        self.act_one_fs.setShortcut("Ctrl+M")
        self.act_one_fs.setToolTip(
            "<b>One filesystem</b> (Ctrl+M)<br>"
            "When on, the scan stops at mount points and measures only the "
            "filesystem the scanned directory lives on, so scanning <tt>/</tt> "
            "shows the root volume instead of every mounted disk, "
            "<tt>/proc</tt> or <tt>/sys</tt> as well (du -x).<br>"
            "Toggling it rescans."
        )
        self.act_one_fs.triggered.connect(self._toggle_one_fs)
        act_fit = QAction(self._icon("fit"), "Fit", self)
        act_fit.setShortcut("Ctrl+0")
        act_fit.setToolTip("Reset zoom and pan to fit the current focus")
        act_fit.triggered.connect(
            lambda _checked=False: self.icicle.fit_view(animate=True)
        )
        self.act_bevel = QAction(self._icon("cube"), "3D", self)
        self.act_bevel.setCheckable(True)
        self.act_bevel.setChecked(style == "bevel")
        self.act_bevel.setToolTip("Raised blocks: light top/left edge, dark "
                                  "bottom/right edge and a soft gradient")
        self.act_bevel.toggled.connect(self._set_bevel)
        tb.addAction(act_open)
        tb.addAction(act_rescan)
        tb.addAction(self.act_stop)
        tb.addAction(act_fit)
        tb.addSeparator()
        tb.addAction(self.act_one_fs)
        tb.addSeparator()
        tb.addWidget(self._colors_button(scheme))
        tb.addAction(self.act_bevel)

        self.statusBar().showMessage("Ready.")
        self.scan(path)

    def _icon(self, kind):
        return make_icon(kind, self.palette().buttonText().color())

    def _set_bevel(self, on):
        self.icicle.set_bevel(on)
        self.settings.setValue("style", "bevel" if on else "flat")

    def _colors_button(self, current):
        labels = {
            "classic": ("Classic", "One hue per top-level entry, lighter with depth"),
            "spacemonger": ("SpaceMonger", "Fixed pastel palette cycling by depth"),
            "rainbow": ("Rainbow", "Every level re-spreads the hues; the first "
                                   "child keeps its parent's"),
        }
        menu = QMenu(self)
        group = QActionGroup(self)
        group.setExclusive(True)
        for scheme in COLOR_SCHEMES:
            text, tip = labels[scheme]
            act = QAction(text, self)
            act.setCheckable(True)
            act.setChecked(scheme == current)
            act.setToolTip(tip)
            act.setData(scheme)
            group.addAction(act)
            menu.addAction(act)
        group.triggered.connect(self._set_scheme)
        btn = QToolButton(self)
        btn.setText("Colors")
        btn.setIcon(self._icon("colors"))
        btn.setToolButtonStyle(Qt.ToolButtonTextBesideIcon)
        btn.setToolTip("Colour scheme of the blocks")
        btn.setMenu(menu)
        btn.setPopupMode(QToolButton.InstantPopup)
        return btn

    def _set_scheme(self, action):
        scheme = action.data()
        self.icicle.set_scheme(scheme)
        self.settings.setValue("colors", scheme)

    def _on_focus(self, node):
        self.breadcrumb.rebuild(node)
        self._selected = None
        self._update_status()

    def _on_selection(self, node):
        self._selected = node
        self._update_status()

    def _update_status(self):
        node = self._selected or self.icicle.focus
        if node is None:
            return
        if node.kind == "disk":
            self.statusBar().showMessage(volume_status(node))
        elif node.synthetic:
            self.statusBar().showMessage(f"{node.name}    {human(node.size)}")
        else:
            self.statusBar().showMessage(f"{node.path}    {human(node.size)}")

    def scan(self, path):
        path = os.path.abspath(path)
        if not os.path.isdir(path):
            QMessageBox.warning(self, "spacequilt", f"Not a directory:\n{path}")
            return
        # A scan still running would keep burning IO and could land its result
        # on top of this one.
        self.stop_scan()
        self._current_path = path
        self.setWindowTitle(f"{path} - spacequilt")
        self.statusBar().showMessage(f"Scanning {path} …")
        self.act_stop.setEnabled(True)
        expected = self.settings.value(self._entries_key(path), None)
        self.scanner = Scanner(
            path, self.one_fs, int(expected) if expected else None
        )
        scanner = self.scanner
        scanner.done.connect(lambda root: self._on_scan_done(root, scanner))
        scanner.failed.connect(lambda msg: self._on_scan_failed(msg, scanner))
        self.scanner.start()
        self._poll_progress()
        self._progress_timer.start()

    @staticmethod
    def _entries_key(path):
        # QSettings treats "/" as a group separator, so the path is encoded.
        return "scan_entries/" + path.replace("/", "%2F")

    def _poll_progress(self):
        if self.scanner is None:
            return
        entries, target, current, secs = self.scanner.progress()
        self.icicle.set_progress(
            (self._current_path, entries, target, current, secs)
        )
        if target:
            pct = min(99, int(100 * entries / target))
            self.statusBar().showMessage(
                f"Scanning {self._current_path} …  {entries:,} entries ({pct}%)"
            )
        else:
            self.statusBar().showMessage(
                f"Scanning {self._current_path} …  {entries:,} entries"
            )

    def _end_progress(self):
        self._progress_timer.stop()
        self.act_stop.setEnabled(False)
        self.icicle.set_progress(None)

    def cancel_scan(self):
        """Abort the running scan; whatever was on screen before stays."""
        if self.scanner is None:
            return
        self.stop_scan()
        self._end_progress()
        self.icicle.empty_text = (
            "Scan cancelled.  Ctrl+R rescans, Ctrl+O opens another directory."
        )
        self.icicle.update()
        self.statusBar().showMessage(f"Scan of {self._current_path} cancelled.")

    def _on_scan_done(self, root, scanner):
        if scanner is not self.scanner:
            return              # superseded or cancelled while it was finishing
        if scanner.builder is not None:
            # Next scan of this path gets a real progress bar from this count.
            self.settings.setValue(
                self._entries_key(scanner.path), scanner.builder.count()
            )
        self._end_progress()
        self.icicle.set_root(root)
        self._update_status()

    def _on_scan_failed(self, msg, scanner):
        if scanner is not self.scanner:
            return
        self._end_progress()
        QMessageBox.critical(self, "spacequilt", f"Scan failed:\n{msg}")
        self.statusBar().showMessage("Scan failed.")

    def stop_scan(self, timeout_ms=2000):
        scanner, self.scanner = self.scanner, None
        if scanner is None:
            return
        scanner.abort()
        if not scanner.wait(timeout_ms):
            # Freeing a QThread that is still running aborts the process.
            self._stopping.append(scanner)

    def closeEvent(self, event):
        self.settings.setValue("window/geometry", self.saveGeometry())
        self.stop_scan()
        self.wait_scanners()
        super().closeEvent(event)

    def wait_scanners(self):
        """Block until every aborted scanner thread has ended: a QThread that
        is still running when its object is destroyed aborts the process."""
        for scanner in self._stopping:
            scanner.wait()
        self._stopping = []

    def _rescan(self):
        self.scan(self._current_path)

    def _toggle_one_fs(self, checked):
        box = QMessageBox(self)
        box.setIcon(QMessageBox.Question)
        box.setWindowTitle("One filesystem")
        box.setText("Stay on one filesystem" if checked else "Cross filesystems")
        box.setInformativeText(
            ("The scan will stop at mount points and measure only the "
             "filesystem that the scanned directory lives on (du -x). "
             "Scanning / then shows the root volume alone, without other "
             "mounted disks, /proc or /sys."
             if checked else
             "The scan will descend into every filesystem mounted under the "
             "scanned directory, so the sizes add up across disks.")
            + "\n\nChanging this rescans the current directory now."
        )
        rescan = box.addButton("Rescan", QMessageBox.AcceptRole)
        box.addButton(QMessageBox.Cancel)
        box.setDefaultButton(rescan)
        box.exec()
        if box.clickedButton() is not rescan:
            self.act_one_fs.blockSignals(True)
            self.act_one_fs.setChecked(not checked)
            self.act_one_fs.blockSignals(False)
            return
        self.one_fs = checked
        self._rescan()

    def _pick_dir(self):
        path = QFileDialog.getExistingDirectory(
            self, "Choose a directory to scan", self._current_path
        )
        if path:
            self.scan(path)


def _install_signal_handlers(app, win):
    """Make Ctrl+C in the terminal work.

    Qt's event loop blocks inside C, so Python never gets to run its signal
    handler and SIGINT is swallowed until the next event. An idle timer hands
    the interpreter a slot often enough to notice.
    """
    def handler(*_args):
        for sig in (signal.SIGINT, signal.SIGTERM):
            signal.signal(sig, signal.SIG_DFL)   # a second one is fatal
        win.stop_scan(500)
        win.wait_scanners()
        app.quit()

    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, handler)
    timer = QTimer(app)
    timer.timeout.connect(lambda: None)
    timer.start(200)
    return timer


def main():
    parser = argparse.ArgumentParser(
        prog="spacequilt", description="Icicle disk-usage viewer."
    )
    parser.add_argument("path", nargs="?", default=".", help="Directory to scan.")
    parser.add_argument(
        "-x",
        "--one-filesystem",
        dest="one_filesystem",
        action="store_true",
        default=True,
        help="Do not cross filesystem boundaries (du -x). This is the default.",
    )
    parser.add_argument(
        "-X",
        "--cross-filesystems",
        dest="one_filesystem",
        action="store_false",
        help="Descend into other mounted filesystems as well.",
    )
    parser.add_argument(
        "--colors",
        choices=COLOR_SCHEMES,
        default=None,
        help="Colour scheme for this run (also remembered as the new default). "
             "Without it the last choice from the toolbar is used.",
    )
    parser.add_argument(
        "--style",
        choices=STYLES,
        default=None,
        help="Block style for this run: flat, or bevel for raised 3D-ish "
             "tiles (also remembered as the new default).",
    )
    args = parser.parse_args()

    app = QApplication(sys.argv)
    app.setApplicationName("spacequilt")
    # Wayland shows the icon the compositor finds for this desktop id, so both
    # the id and the window icon have to be set for it to appear everywhere.
    app.setDesktopFileName("spacequilt")
    if os.path.exists(ICON_PATH):
        app.setWindowIcon(QIcon(ICON_PATH))
    win = MainWindow(args.path, args.one_filesystem, args.colors, args.style)
    if args.colors:
        win.settings.setValue("colors", args.colors)
    if args.style:
        win.settings.setValue("style", args.style)
    _sigint_timer = _install_signal_handlers(app, win)   # noqa: F841 (keep alive)
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()

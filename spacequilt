    def _setting(self, key, allowed, default):
        """A remembered choice, with old value names mapped to current ones."""
        value = self.settings.value(key, default)
        value = LEGACY_VALUES.get(value, value)
        return value if value in allowed else default

    def _icon(self, kind):
        return make_icon(kind, self.palette().buttonText().color())

    def _set_style(self, style):
        for widget in self.views.values():
            widget.set_style(style)
        self.settings.setValue("style", style)

    def show_start(self):
        """The volumes / recent / browse page, over whatever is shown."""
        recent = self.settings.value("recent", [])
        if isinstance(recent, str):
            recent = [recent]
        self.start.rebuild(list(recent or []), self.view.focus is not None)
        self.stack.setCurrentWidget(self.start)
        self.start.setFocus()

    def _leave_start(self):
        self.stack.setCurrentWidget(self.view)
        self.view.setFocus()

    def _remember_recent(self, path):
        recent = self.settings.value("recent", [])
        if isinstance(recent, str):
            recent = [recent]
        recent = [path] + [p for p in (recent or []) if p != path]
        self.settings.setValue("recent", recent[:8])

    def set_view(self, name):
        """Switch the visible view; it adopts the current focus (no animation)."""
        new = self.views[name]
        if new is self.view:
            if self.stack.currentWidget() is not new:
                self._leave_start()
            return
        old, self.view = self.view, new
        if old.focus is not None and new.focus is not old.focus:
            new.set_focus(old.focus)
        new.set_selected(None)
        if self.stack.currentWidget() is not self.start:
            self.stack.setCurrentWidget(new)
            new.setFocus()
        self.view_actions[name].setChecked(True)
        self.settings.setValue("view", name)
        for act in self.colors_button.menu().actions():
            act.setChecked(act.data() == new.scheme)
        self._on_focus(new.focus)

    def _menu_button(self, title, icon, tip, options, current, handler):
        """Toolbar button with an exclusive menu; `handler` gets the chosen id."""
        menu = QMenu(self)
        group = QActionGroup(self)
        group.setExclusive(True)
        for value, text, item_tip in options:
            act = QAction(text, self)
            act.setCheckable(True)
            act.setChecked(value == current)
            act.setToolTip(item_tip)
            act.setData(value)
            group.addAction(act)
            menu.addAction(act)
        group.triggered.connect(lambda act: handler(act.data()))
        btn = QToolButton(self)
        btn.setText(title)
        btn.setIcon(self._icon(icon))
        btn.setToolButtonStyle(Qt.ToolButtonTextBesideIcon)
        btn.setToolTip(tip)
        btn.setMenu(menu)
        btn.setPopupMode(QToolButton.InstantPopup)
        return btn

    def _set_scheme(self, scheme):
        """Only the visible view changes; the other keeps its own scheme."""
        self.view.set_scheme(scheme)
        name = next(n for n, w in self.views.items() if w is self.view)
        self.settings.setValue(f"colors/{name}", scheme)

    def _on_focus(self, node):
        sender = self.sender()
        if sender is not None and sender is not self.view:
            return          # the hidden view echoing set_focus()
        self.breadcrumb.rebuild(node)
        self._selected = None
        self._update_status()

    def _on_selection(self, node):
        if self.sender() is not self.view:
            return
        self._selected = node
        self._update_status()

    def _update_status(self):
        node = self._selected or self.view.focus
        if node is None:
            return
        if node.kind == "disk":
            self.statusBar().showMessage(volume_status(node))
        elif node.synthetic:
            self.statusBar().showMessage(f"{node.name}    {human(node.size)}")
        else:
            self.statusBar().showMessage(f"{node.path}    {human(node.size)}")

    def scan(self, path):
        path = os.path.abspath(path)
        if not os.path.isdir(path):
            QMessageBox.warning(self, "SpaceQuilt", f"Not a directory:\n{path}")
            return
        # A scan still running would keep burning IO and could land its result
        # on top of this one.
        self.stop_scan()
        self._current_path = path
        self._leave_start()
        self.setWindowTitle(f"{path} - SpaceQuilt")
        self.statusBar().showMessage(f"Scanning {path} …")
        self.act_stop.setEnabled(True)
        expected = self.settings.value(self._entries_key(path), None)
        self.scanner = Scanner(
            path, self.one_fs, int(expected) if expected else None
        )
        scanner = self.scanner
        scanner.done.connect(lambda root: self._on_scan_done(root, scanner))
        scanner.failed.connect(lambda msg: self._on_scan_failed(msg, scanner))
        self.scanner.start()
        self._poll_progress()
        self._progress_timer.start()

    @staticmethod
    def _entries_key(path):
        # QSettings treats "/" as a group separator, so the path is encoded.
        return "scan_entries/" + path.replace("/", "%2F")

    def _poll_progress(self):
        if self.scanner is None:
            return
        entries, target, current, secs = self.scanner.progress()
        for widget in self.views.values():
            widget.set_progress((self._current_path, entries, target, current, secs))
        if target:
            pct = min(99, int(100 * entries / target))
            self.statusBar().showMessage(
                f"Scanning {self._current_path} …  {entries:,} entries ({pct}%)"
            )
        else:
            self.statusBar().showMessage(
                f"Scanning {self._current_path} …  {entries:,} entries"
            )

    def _end_progress(self):
        self._progress_timer.stop()
        self.act_stop.setEnabled(False)
        for widget in self.views.values():
            widget.set_progress(None)

    def cancel_scan(self):
        """Abort the running scan; whatever was on screen before stays."""
        if self.scanner is None:
            return
        self.stop_scan()
        self._end_progress()
        for widget in self.views.values():
            widget.empty_text = (
                "Scan cancelled. Ctrl+R scans again, Ctrl+O picks another directory."
            )
            widget.update()
        self.statusBar().showMessage(f"Scan of {self._current_path} cancelled.")

    def _on_scan_done(self, root, scanner):
        if scanner is not self.scanner:
            return              # superseded or cancelled while it was finishing
        if scanner.builder is not None:
            # Next scan of this path gets a real progress bar from this count.
            self.settings.setValue(
                self._entries_key(scanner.path), scanner.builder.count()
            )
        self._end_progress()
        self._remember_recent(scanner.path)
        for widget in self.views.values():
            widget.set_root(root)
        self._update_status()

    def _on_scan_failed(self, msg, scanner):
        if scanner is not self.scanner:
            return
        self._end_progress()
        QMessageBox.critical(self, "SpaceQuilt", f"Scan failed:\n{msg}")
        self.statusBar().showMessage("Scan failed.")

    def stop_scan(self, timeout_ms=2000):
        scanner, self.scanner = self.scanner, None
        if scanner is None:
            return
        scanner.abort()
        if not scanner.wait(timeout_ms):
            # Freeing a QThread that is still running aborts the process.
            self._stopping.append(scanner)

    def closeEvent(self, event):
        self.settings.setValue("window/geometry", self.saveGeometry())
        self.stop_scan()
        self.wait_scanners()
        super().closeEvent(event)

    def wait_scanners(self):
        """Block until every aborted scanner thread has ended: a QThread that
        is still running when its object is destroyed aborts the process."""
        for scanner in self._stopping:
            scanner.wait()
        self._stopping = []

    def _rescan(self):
        self.scan(self._current_path)

    def _toggle_one_fs(self, checked):
        box = QMessageBox(self)
        box.setIcon(QMessageBox.Question)
        box.setWindowTitle("One filesystem")
        box.setText("Stay on one filesystem" if checked else "Cross filesystems")
        box.setInformativeText(
            ("The scan will stop at mount points (du -x) and measure the "
             "filesystem of the scanned directory alone. A scan of / then "
             "leaves out the other disks, /proc and /sys."
             if checked else
             "The scan will descend into every filesystem mounted below the "
             "scanned directory and add their sizes together.")
            + "\n\nSpaceQuilt rescans the current directory when you confirm."
        )
        rescan = box.addButton("Rescan", QMessageBox.AcceptRole)
        box.addButton(QMessageBox.Cancel)
        box.setDefaultButton(rescan)
        box.exec()
        if box.clickedButton() is not rescan:
            self.act_one_fs.blockSignals(True)
            self.act_one_fs.setChecked(not checked)
            self.act_one_fs.blockSignals(False)
            return
        self.one_fs = checked
        self._rescan()

    def _pick_dir(self):
        path = QFileDialog.getExistingDirectory(
            self, "Choose a directory to scan", self._current_path
        )
        if path:
            self.scan(path)


def _install_signal_handlers(app, win):
    """Make Ctrl+C in the terminal work.

    Qt's event loop blocks inside C, so Python never gets to run its signal
    handler and SIGINT is swallowed until the next event. An idle timer hands
    the interpreter a slot often enough to notice.
    """
    def handler(*_args):
        for sig in (signal.SIGINT, signal.SIGTERM):
            signal.signal(sig, signal.SIG_DFL)   # a second one is fatal
        win.stop_scan(500)
        win.wait_scanners()
        app.quit()

    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, handler)
    timer = QTimer(app)
    timer.timeout.connect(lambda: None)
    timer.start(200)
    return timer


def main():
    parser = argparse.ArgumentParser(
        prog="spacequilt", description="Disk-usage viewer: icicle columns or nested boxes."
    )
    parser.add_argument(
        "path", nargs="?", default=None,
        help="Directory to scan. Without it, the volumes page opens.",
    )
    parser.add_argument(
        "-x",
        "--one-filesystem",
        dest="one_filesystem",
        action="store_true",
        default=True,
        help="Stay on one filesystem (du -x). The default.",
    )
    parser.add_argument(
        "-X",
        "--cross-filesystems",
        dest="one_filesystem",
        action="store_false",
        help="Descend into every filesystem mounted below PATH.",
    )
    parser.add_argument(
        "--colors",
        choices=COLOR_SCHEMES,
        default=None,
        help="Colour scheme of the starting view. SpaceQuilt remembers it for "
             "that view.",
    )
    parser.add_argument(
        "--view",
        choices=VIEWS,
        default=None,
        help="View to start in: boxes (nested boxes, the default) or icicle "
             "(columns). SpaceQuilt remembers it.",
    )
    parser.add_argument(
        "--style",
        choices=STYLES,
        default=None,
        help="Relief of the blocks: flat, raised (the default) or deep. "
             "SpaceQuilt remembers it.",
    )
    args = parser.parse_args()

    app = QApplication(sys.argv)
    app.setApplicationName("SpaceQuilt")
    # Wayland shows the icon the compositor finds for this desktop id, so both
    # the id and the window icon have to be set for it to appear everywhere.
    app.setDesktopFileName("spacequilt")
    if os.path.exists(ICON_PATH):
        app.setWindowIcon(QIcon(ICON_PATH))
    win = MainWindow(args.path, args.one_filesystem, args.colors, args.style, args.view)
    if args.style:
        win.settings.setValue("style", args.style)
    if args.view:
        win.settings.setValue("view", args.view)
    _sigint_timer = _install_signal_handlers(app, win)   # noqa: F841 (keep alive)
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()

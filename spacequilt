class StartPage(QWidget):
    """What you see before (or instead of) a tree: the mounted volumes to
    scan, recent scans, and a way to pick any folder."""
    scan_requested = Signal(str)
    browse_requested = Signal()
    back_requested = Signal()

    def __init__(self):
        super().__init__()
        self.setStyleSheet("background: #1e1f22;")
        self.setFocusPolicy(Qt.StrongFocus)
        outer = QVBoxLayout(self)
        outer.setContentsMargins(0, 0, 0, 0)
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.NoFrame)
        outer.addWidget(scroll)
        body = QWidget()
        scroll.setWidget(body)
        col = QVBoxLayout(body)
        col.setContentsMargins(0, 28, 0, 28)
        col.setAlignment(Qt.AlignHCenter | Qt.AlignTop)
        self._content = QWidget()
        self._content.setMaximumWidth(720)
        col.addWidget(self._content)
        self._lay = QVBoxLayout(self._content)
        self._lay.setContentsMargins(24, 0, 24, 0)
        self._lay.setSpacing(10)
        self.back_btn = None
        self.rebuild([], False)

    def rebuild(self, recent, can_go_back):
        while self._lay.count():
            item = self._lay.takeAt(0)
            w = item.widget()
            if w is not None:
                w.deleteLater()
        heading = QLabel("Scan a volume")
        heading.setStyleSheet("color: #f0f0f0; font-size: 20px; font-weight: 600;")
        self._lay.addWidget(heading)
        volumes = list_volumes()
        if not volumes:
            none = QLabel("No mounted volumes found.")
            none.setStyleSheet("color: #a9aeb7;")
            self._lay.addWidget(none)
        for vol in volumes:
            card = VolumeCard(*vol)
            card.clicked.connect(self.scan_requested)
            self._lay.addWidget(card)
        if recent:
            self._lay.addSpacing(14)
            sub = QLabel("Recent")
            sub.setStyleSheet("color: #f0f0f0; font-size: 16px; font-weight: 600;")
            self._lay.addWidget(sub)
            for path in recent:
                btn = QPushButton(path)
                btn.setFlat(True)
                btn.setCursor(Qt.PointingHandCursor)
                btn.setStyleSheet("QPushButton { color: #c8c8c8; text-align: left; padding: 6px 10px; }"
                                  "QPushButton:hover { color: #ffffff; background: #2b2d31; }")
                btn.clicked.connect(lambda _=False, p=path: self.scan_requested.emit(p))
                self._lay.addWidget(btn)
        self._lay.addSpacing(14)
        row = QHBoxLayout()
        browse = QPushButton("Browse for a folder…")
        browse.setCursor(Qt.PointingHandCursor)
        browse.clicked.connect(self.browse_requested)
        row.addWidget(browse)
        self.back_btn = QPushButton("Back to the scan")
        self.back_btn.setCursor(Qt.PointingHandCursor)
        self.back_btn.clicked.connect(self.back_requested)
        self.back_btn.setVisible(can_go_back)
        row.addWidget(self.back_btn)
        row.addStretch()
        holder = QWidget()
        holder.setLayout(row)
        self._lay.addWidget(holder)

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Escape and self.back_btn is not None and self.back_btn.isVisible():
            self.back_requested.emit()
        else:
            super().keyPressEvent(event)



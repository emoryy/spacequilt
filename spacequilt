        if style is None:
            style = self._setting("style", STYLES, DEFAULT_STYLE)
        if view is None:
            view = self._setting("view", VIEWS, DEFAULT_VIEW)
        # Per-view schemes. A single "colors" value from before they were
        # split seeds both views once and is then dropped.
        legacy = self.settings.value("colors")
        if isinstance(legacy, str):
            # Remove first: QSettings.remove("colors") would also drop the
            # colors/<view> keys written below.
            self.settings.remove("colors")
            legacy = LEGACY_VALUES.get(legacy, legacy)
            if legacy in COLOR_SCHEMES:
                for name in VIEWS:
                    self.settings.setValue(f"colors/{name}", legacy)
        schemes = {
            name: self._setting(f"colors/{name}", COLOR_SCHEMES, VIEW_SCHEMES[name])
            for name in VIEWS
        }

# Minimum on-screen height (px) for a block to be drawn / recursed into.
MIN_BLOCK_PX = 2.0
# Column width is clamped to this range; within it we aim for ~7 visible levels.
COL_MIN, COL_MAX = 130, 230
# Logical layout space: the focus node is LOGICAL_H tall and one column is
# LOGICAL_COLW wide. The viewport (zx/zy/pan) maps that onto the widget.
LOGICAL_H = 1000.0
LOGICAL_COLW = 170.0
ZOOM_STEP = 1.0018          # per wheel unit; one notch (120) is about 1.24x
# The horizontal axis carries depth, not detail, so widening columns as fast as
# the vertical zoom would push every deeper level off screen after a few
# notches. Damp it: 1.0 gives a strictly uniform zoom, 0 pins the width.
# Column width is derived from the vertical zoom (times a user offset set by
# the one-axis wheel modes) rather than tracked separately, so the two axes
# cannot drift apart when one of them hits its clamp before the other.
H_ZOOM_DAMPING = 0.4
KEY_ZOOM_STEP = 1.25
FIT_ANIM_MS = 320
NAV_ANIM_MS = 360           # drill in / out
FADE_MS = 220               # crossfade over the colour change at a focus switch
ZOOM_OUT_LIMIT = 0.25       # both limits are relative to the fit zoom
ZOOM_IN_CAP = 1e7
ZOOM_IN_UNIT = 4096.0       # stop zooming near "one screen = one disk block"
COLW_MIN_PX, COLW_MAX_PX = 14.0, 900.0
DRAG_THRESHOLD = 4.0        # px of movement before a click becomes a pan
HALO_ALPHA = 60             # heavier than this visibly thins the glyphs
# Per-node lightness jitter (+-), hashed from the path so it is stable across
# rescans. Adjacent same-hue siblings stay distinguishable while scrolling.
SHADE_JITTER = 0.05
COLOR_SCHEMES = ("classic", "spacemonger", "rainbow")
DEFAULT_SCHEME = "classic"
STYLES = ("flat", "bevel")
DEFAULT_STYLE = "bevel"
# SpaceMonger's look: one flat pastel per depth counted from the scanned root,
# cycling. Approximated from screenshots, in depth order.
SPACEMONGER_PALETTE = (
    "#ff8080",   # salmon
    "#ffff50",   # yellow
    "#80ff80",   # green
    "#80ffff",   # cyan
    "#9090ff",   # lavender
    "#ff80ff",   # magenta
    "#c0c0c0",   # grey
)
